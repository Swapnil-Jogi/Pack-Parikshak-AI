<!-- Top Tricolor Ribbon -->
<div class="w-full flex h-1.5">
  <div class="w-1/3 bg-amber-500"></div>
  <div class="w-1/3 bg-white"></div>
  <div class="w-1/3 bg-emerald-600"></div>
</div>

<!-- Government Header Bar -->
<header class="bg-slate-950 text-white border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2">
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
      <div class="flex items-center space-x-3 text-slate-300">
        <span class="inline-flex items-center font-medium">
          <i class="fa-solid fa-landmark text-amber-400 me-1.5"></i>
          <%= t('govIndia') %>
        </span>
        <span class="hidden md:inline text-slate-500">|</span>
        <span class="hidden md:inline text-slate-300"><%= t('deptConsumerAffairs') %></span>
      </div>

      <div class="flex items-center space-x-4">
        <a href="tel:1915" class="text-amber-400 hover:text-amber-300 flex items-center font-semibold">
          <i class="fa-solid fa-phone-volume me-1"></i> <%= t('helpline') %>
        </a>

        <!-- 10 Indian Languages Switcher -->
        <div class="relative dropdown">
          <button class="bg-slate-900 hover:bg-slate-800 text-white px-2.5 py-1 rounded text-xs border border-slate-700 flex items-center gap-1.5 transition" type="button" id="langDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-solid fa-language text-amber-400"></i>
            <span>
              <% 
                const cur = supportedLanguages.find(l => l.code === currentLang);
                out = cur ? cur.native : 'English';
              %>
              <%= out %>
            </span>
            <i class="fa-solid fa-chevron-down text-[10px]"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-lg border border-slate-200 text-xs py-1" aria-labelledby="langDropdown">
            <% supportedLanguages.forEach(l => { %>
              <li>
                <a class="dropdown-item flex items-center justify-between py-1.5 px-3 <%= currentLang === l.code ? 'active bg-slate-900 text-white font-semibold' : 'text-slate-700 hover:bg-slate-100' %>" href="/lang?lang=<%= l.code %>">
                  <span><%= l.native %></span>
                  <span class="text-[10px] <%= currentLang === l.code ? 'text-slate-200' : 'text-slate-400' %>">(<%= l.name %>)</span>
                </a>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <nav class="bg-slate-900 text-white border-t border-slate-800 shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        
        <!-- Brand Logo & Title -->
        <a href="/" class="flex items-center space-x-3 text-decoration-none group">
          <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center text-slate-950 shadow-md font-bold text-xl group-hover:scale-105 transition">
            <i class="fa-solid fa-scale-balanced"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-extrabold text-lg tracking-tight text-white"><%= t('portalName') %></span>
              <span class="bg-amber-500/20 text-amber-300 text-[10px] font-bold px-1.5 py-0.5 rounded border border-amber-500/30">SIH-26034</span>
            </div>
            <div class="text-[10px] text-slate-400 truncate max-w-[280px] sm:max-w-md">
              <%= t('subTitle') %>
            </div>
          </div>
        </a>

        <!-- Desktop Navigation Links (Horizontally and Vertically Centered) -->
        <div class="hidden lg:flex items-center space-x-2">
          <a href="/" class="nav-link-item px-3 py-2 rounded-lg text-xs font-semibold text-slate-200 hover:text-white transition flex items-center gap-1.5">
            <i class="fa-solid fa-house text-slate-400 text-xs"></i>
            <span><%= t('home') %></span>
          </a>
          <a href="/inspections/new" class="nav-link-item px-3 py-2 rounded-lg text-xs font-bold text-amber-300 bg-amber-500/10 border border-amber-500/30 hover:bg-amber-500/20 transition flex items-center gap-1.5">
            <i class="fa-solid fa-magnifying-glass"></i>
            <span><%= t('scan') %></span>
          </a>
          <% if (user && user.role === 'officer') { %>
            <a href="/officer/dashboard" class="nav-link-item px-3 py-2 rounded-lg text-xs font-bold text-amber-300 bg-slate-800 border border-amber-500/50 hover:bg-slate-700 transition flex items-center gap-1.5 shadow-sm">
              <i class="fa-solid fa-shield-halved text-amber-400"></i>
              <span><%= t('officerPortal') %></span>
            </a>
          <% } else if (user) { %>
            <a href="/dashboard" class="nav-link-item px-3 py-2 rounded-lg text-xs font-semibold text-slate-200 hover:text-white transition flex items-center gap-1.5">
              <i class="fa-solid fa-folder-open text-slate-400 text-xs"></i>
              <span><%= t('dashboard') %></span>
            </a>
          <% } %>
          <a href="/lmpc-guide" class="nav-link-item px-3 py-2 rounded-lg text-xs font-semibold text-slate-200 hover:text-white transition flex items-center gap-1.5">
            <i class="fa-solid fa-award text-slate-400 text-xs"></i>
            <span><%= t('lmpcGuide') %></span>
          </a>
        </div>

        <!-- Auth Actions (Consumer Sign In & Officer Sign In) -->
        <div class="flex items-center space-x-2">
          <% if (user) { %>
            <div class="dropdown">
              <button class="nav-link-item flex items-center gap-1.5 bg-slate-800 hover:bg-slate-700 text-white px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-700 hover:border-amber-400 transition-all duration-200 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-circle-user text-amber-400 text-sm"></i>
                <span class="truncate max-w-[130px]">Hi <%= user.name %></span>
                <% if (user.role === 'officer') { %>
                  <span class="badge bg-amber-500 text-slate-950 text-[8px] font-bold px-1 py-0.2 rounded ms-0.5">OFFICER</span>
                <% } %>
                <i class="fa-solid fa-chevron-down text-[10px] text-slate-400 ms-0.5"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow-xl border border-slate-200 text-xs py-1.5 mt-1 rounded-lg">
                <li class="px-3 py-1.5 border-b border-slate-100 text-slate-500 font-medium flex items-center justify-between gap-2">
                  <span class="truncate max-w-[140px]"><%= user.email %></span>
                  <% if (user.role === 'officer') { %>
                    <span class="badge bg-amber-500 text-slate-950 text-[9px] font-bold px-1.5 py-0.5 rounded">Officer</span>
                  <% } else { %>
                    <span class="badge bg-slate-200 text-slate-700 text-[9px] font-medium px-1.5 py-0.5 rounded">Consumer</span>
                  <% } %>
                </li>
                <% if (user.role === 'officer') { %>
                  <li>
                    <a class="dropdown-item py-1.5 flex items-center gap-2 text-slate-900 font-bold hover:bg-blue-50" href="/officer/dashboard">
                      <i class="fa-solid fa-shield-halved text-amber-500"></i> <%= t('officerPortal') %>
                    </a>
                  </li>
                  <li>
                    <a class="dropdown-item py-1.5 flex items-center gap-2 text-slate-700 hover:bg-slate-50 hover:text-blue-700 font-medium" href="/dashboard">
                      <i class="fa-solid fa-images text-slate-400"></i> <%= t('dashboard') %> (Uploaded Scans)
                    </a>
                  </li>
                <% } else { %>
                  <li>
                    <a class="dropdown-item py-1.5 flex items-center gap-2 text-slate-700 hover:bg-slate-50 hover:text-blue-700 font-medium" href="/dashboard">
                      <i class="fa-solid fa-folder-open text-slate-400"></i> <%= t('dashboard') %>
                    </a>
                  </li>
                <% } %>
                <li><hr class="dropdown-divider my-1"></li>
                <li>
                  <a class="dropdown-item py-1.5 text-red-600 hover:bg-red-50 flex items-center gap-2 font-medium" href="/auth/logout">
                    <i class="fa-solid fa-right-from-bracket"></i> <%= t('logout') %>
                  </a>
                </li>
              </ul>
            </div>
          <% } else { %>
            <div class="flex items-center space-x-2">
              <a href="/auth/login?role=user" class="nav-link-item text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-700 hover:border-slate-500 transition flex items-center gap-1.5 shadow-sm" title="Sign In as Consumer or Business Packer">
                <i class="fa-solid fa-user text-slate-400 text-xs"></i>
                <span class="hidden sm:inline"><%= t('consumerSignIn') %></span>
                <span class="sm:hidden"><%= t('login') %></span>
              </a>
              <a href="/auth/login?role=officer" class="nav-link-item text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-amber-300 hover:text-amber-200 border border-amber-500/50 hover:border-amber-400 transition flex items-center gap-1.5 shadow-sm" title="Official Legal Metrology Enforcement Officer Sign In">
                <i class="fa-solid fa-shield-halved text-amber-400 text-xs"></i>
                <span class="hidden sm:inline"><%= t('officerSignIn') %></span>
                <span class="sm:hidden"><%= t('officerPortal') %></span>
              </a>
              <a href="/auth/register" class="nav-link-item text-xs font-bold px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-slate-950 shadow-sm hover:shadow transition flex items-center gap-1">
                <i class="fa-solid fa-user-plus text-xs"></i>
                <span><%= t('register') %></span>
              </a>
            </div>
          <% } %>

          <!-- Mobile Menu Button -->
          <button class="nav-link-item lg:hidden text-slate-300 hover:text-white p-2 rounded-lg hover:bg-slate-800 transition" type="button" data-bs-toggle="collapse" data-bs-target="#mobileMenu">
            <i class="fa-solid fa-bars text-lg"></i>
          </button>
        </div>

      </div>
    </div>

    <!-- Mobile Menu Collapse -->
    <div class="collapse lg:hidden bg-slate-950 border-t border-slate-800 px-4 py-3" id="mobileMenu">
      <div class="flex flex-col space-y-2 text-sm">
        <a href="/" class="nav-link-item py-2 px-3 rounded-lg text-slate-200 hover:text-white flex items-center gap-2">
          <i class="fa-solid fa-house text-slate-400 text-xs"></i> <%= t('home') %>
        </a>
        <a href="/inspections/new" class="nav-link-item py-2 px-3 rounded-lg text-amber-300 font-semibold bg-amber-500/10 border border-amber-500/30 flex items-center gap-2">
          <i class="fa-solid fa-magnifying-glass text-xs"></i> <%= t('scan') %>
        </a>
        <a href="/lmpc-guide" class="nav-link-item py-2 px-3 rounded-lg text-slate-200 hover:text-white flex items-center gap-2">
          <i class="fa-solid fa-certificate text-slate-400 text-xs"></i> <%= t('lmpcGuide') %>
        </a>

        <% if (user) { %>
          <div class="pt-3 border-t border-slate-800 flex flex-col space-y-2">
            <div class="px-3 py-2 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-between text-xs">
              <span class="text-slate-200 truncate font-semibold"><i class="fa-solid fa-circle-user text-amber-400 me-1"></i> <%= user.name %></span>
              <% if (user.role === 'officer') { %>
                <span class="badge bg-amber-500 text-slate-950 text-[9px] font-bold px-1.5 py-0.5 rounded">Officer</span>
              <% } else { %>
                <span class="badge bg-slate-700 text-slate-200 text-[9px] font-medium px-1.5 py-0.5 rounded">Consumer</span>
              <% } %>
            </div>
            <% if (user.role === 'officer') { %>
              <a href="/officer/dashboard" class="nav-link-item py-2 px-3 rounded-lg text-xs font-bold text-amber-300 bg-slate-900 border border-amber-500/40 flex items-center gap-2">
                <i class="fa-solid fa-shield-halved text-amber-400"></i> <%= t('officerPortal') %>
              </a>
              <a href="/dashboard" class="nav-link-item py-2 px-3 rounded-lg text-xs font-semibold text-slate-200 bg-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-images text-slate-400"></i> <%= t('dashboard') %> (Uploaded Scans)
              </a>
            <% } else { %>
              <a href="/dashboard" class="nav-link-item py-2 px-3 rounded-lg text-xs font-semibold text-slate-200 bg-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-folder-open text-slate-400"></i> <%= t('dashboard') %>
              </a>
            <% } %>
            <a href="/auth/logout" class="nav-link-item py-2 px-3 rounded-lg text-xs font-semibold text-red-400 bg-red-950/40 border border-red-900/50 flex items-center gap-2">
              <i class="fa-solid fa-right-from-bracket"></i> <%= t('logout') %>
            </a>
          </div>
        <% } else { %>
          <div class="pt-3 border-t border-slate-800 flex flex-col space-y-2">
            <a href="/auth/login?role=user" class="nav-link-item py-2 px-3 rounded-lg text-xs font-semibold text-slate-200 bg-slate-800 border border-slate-700 flex items-center gap-2">
              <i class="fa-solid fa-user text-slate-400"></i> <%= t('consumerSignIn') %>
            </a>
            <a href="/auth/login?role=officer" class="nav-link-item py-2 px-3 rounded-lg text-xs font-semibold text-amber-300 bg-slate-900 border border-amber-500/40 flex items-center gap-2">
              <i class="fa-solid fa-shield-halved text-amber-400"></i> <%= t('officerSignIn') %>
            </a>
            <a href="/auth/register" class="nav-link-item py-2 px-3 rounded-lg text-xs font-bold text-slate-950 bg-amber-500 flex items-center gap-2">
              <i class="fa-solid fa-user-plus text-xs"></i> <%= t('register') %>
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </nav>
</header>

<!-- Flash Notifications Partial -->
<%- include('flash') %>

<script>
  // Tactile clicking outline effect for navbar tabs
  document.addEventListener('DOMContentLoaded', function () {
    const navItems = document.querySelectorAll('.nav-link-item');
    navItems.forEach(function (el) {
      el.addEventListener('mousedown', function () {
        el.classList.add('tab-clicked');
      });
      el.addEventListener('mouseup', function () {
        setTimeout(function () { el.classList.remove('tab-clicked'); }, 200);
      });
      el.addEventListener('mouseleave', function () {
        el.classList.remove('tab-clicked');
      });
    });
  });
</script>

