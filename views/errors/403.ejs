<%- include('../partials/header', { title: '403 Forbidden | Pack-Parikshak AI' }) %>
<%- include('../partials/navbar') %>

<main class="flex-grow flex items-center justify-center py-16 px-4">
  <div class="max-w-md w-full text-center bg-white p-8 rounded-xl shadow-sm border border-slate-200">
    <div class="w-16 h-16 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold">
      <i class="fa-solid fa-lock"></i>
    </div>
    <h1 class="text-2xl font-extrabold text-slate-900 mb-2">403 - Restricted Access</h1>
    <p class="text-sm text-slate-600 mb-6">
      <%= typeof message !== 'undefined' ? message : 'Access to the Enforcement Officer Command Hub requires authorized regulatory officer credentials.' %>
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/auth/demo/officer" class="btn btn-warning text-xs font-bold py-2 px-4 shadow-sm">
        <i class="fa-solid fa-shield-halved me-1"></i> Sign in as Demo Officer
      </a>
      <a href="/" class="btn btn-outline-secondary text-xs font-semibold py-2 px-4">
        Return to Home
      </a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

