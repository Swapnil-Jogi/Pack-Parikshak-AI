<%- include('../partials/header', { title: t('lmpcMainHeading') + ' | ' + t('portalName') }) %>
<%- include('../partials/navbar') %>

<main class="flex-grow py-10 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto w-full">
  
  <!-- Guide Header -->
  <div class="mb-10 text-center max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-govblue text-xs font-bold border border-blue-200 mb-3">
      <i class="fa-solid fa-certificate text-amber-500"></i> <%= t('lmpcRuleBadge') %>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
      <%= t('lmpcMainHeading') %>
    </h1>
    <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
      <%= t('lmpcMainDesc') %>
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
    
    <!-- LEFT COLUMN: Interactive Fee & Timeline Calculator (col-span-5) -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Calculator Box -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4 flex items-center gap-2">
          <i class="fa-solid fa-calculator text-amber-500"></i> <%= t('lmpcCalcHeading') %>
        </h3>

        <div class="space-y-4 text-xs">
          <div>
            <label class="block font-semibold text-slate-700 mb-1"><%= t('lmpcApplicantCategory') %></label>
            <select id="lmpcApplicantType" class="form-select form-select-sm text-xs rounded-lg">
              <option value="importer"><%= t('lmpcImporterOpt') %></option>
              <option value="manufacturer"><%= t('lmpcManufacturerOpt') %></option>
            </select>
          </div>

          <div>
            <label class="block font-semibold text-slate-700 mb-1"><%= t('lmpcJurisdictionState') %></label>
            <select id="lmpcState" class="form-select form-select-sm text-xs rounded-lg">
              <option value="Delhi">Delhi</option>
              <option value="Maharashtra">Maharashtra</option>
              <option value="Karnataka">Karnataka</option>
              <option value="Gujarat">Gujarat</option>
              <option value="Tamil Nadu">Tamil Nadu</option>
              <option value="Uttar Pradesh">Uttar Pradesh</option>
              <option value="West Bengal">West Bengal</option>
              <option value="Punjab">Punjab</option>
            </select>
          </div>

          <div>
            <label class="block font-semibold text-slate-700 mb-1"><%= t('lmpcEnterpriseScale') %></label>
            <select id="lmpcScale" class="form-select form-select-sm text-xs rounded-lg">
              <option value="micro"><%= t('lmpcMicroScale') %></option>
              <option value="medium"><%= t('lmpcMediumScale') %></option>
              <option value="large"><%= t('lmpcLargeScale') %></option>
            </select>
          </div>

          <!-- Dynamic Output Results -->
          <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2 mt-4">
            <div class="flex items-center justify-between">
              <span class="text-slate-500 font-medium"><%= t('lmpcStatutoryFee') %></span>
              <span class="text-base font-extrabold text-emerald-600" id="lmpcFeeDisplay">₹ 500</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-500 font-medium"><%= t('lmpcEstimatedTimeline') %></span>
              <span class="font-bold text-slate-800" id="lmpcTimelineDisplay">20-25 Working Days</span>
            </div>
            <div class="pt-2 border-t border-slate-200">
              <span class="text-slate-500 font-medium block mb-1"><%= t('lmpcCompetentAuthority') %></span>
              <span class="font-semibold text-slate-800 text-[11px] block leading-tight" id="lmpcAuthorityDisplay">
                Director of Legal Metrology, Krishi Bhawan, New Delhi
              </span>
            </div>
          </div>

          <a href="https://www.nsws.gov.in" target="_blank" id="lmpcPortalLink" class="w-full btn bg-govblue hover:bg-govblue-dark text-white font-bold text-xs py-2.5 rounded-lg shadow-sm flex items-center justify-center gap-1.5 transition">
            <i class="fa-solid fa-arrow-up-right-from-square"></i> <%= t('lmpcApplyNationalPortal') %>
          </a>
        </div>
      </div>

      <!-- Document Readiness Tracker -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">
            <%= t('lmpcDocChecklistHeading') %>
          </h3>
          <span class="text-[10px] font-bold text-amber-600" id="docReadinessPct">0% Ready</span>
        </div>

        <div class="w-full bg-slate-100 rounded-full h-2 mb-4 overflow-hidden">
          <div id="docReadinessBar" class="h-2 rounded-full bg-emerald-600 transition-all duration-300" style="width: 0%"></div>
        </div>

        <div class="space-y-2.5 text-xs text-slate-700">
          <label class="flex items-start gap-2 cursor-pointer">
            <input type="checkbox" class="lmpc-doc-check mt-0.5 rounded border-slate-300 text-govblue focus:ring-govblue">
            <span><%= t('lmpcDoc1') %></span>
          </label>
          <label class="flex items-start gap-2 cursor-pointer">
            <input type="checkbox" class="lmpc-doc-check mt-0.5 rounded border-slate-300 text-govblue focus:ring-govblue">
            <span><%= t('lmpcDoc2') %></span>
          </label>
          <label class="flex items-start gap-2 cursor-pointer">
            <input type="checkbox" class="lmpc-doc-check mt-0.5 rounded border-slate-300 text-govblue focus:ring-govblue">
            <span><%= t('lmpcDoc3') %></span>
          </label>
          <label class="flex items-start gap-2 cursor-pointer">
            <input type="checkbox" class="lmpc-doc-check mt-0.5 rounded border-slate-300 text-govblue focus:ring-govblue">
            <span><%= t('lmpcDoc4') %></span>
          </label>
          <label class="flex items-start gap-2 cursor-pointer">
            <input type="checkbox" class="lmpc-doc-check mt-0.5 rounded border-slate-300 text-govblue focus:ring-govblue">
            <span><%= t('lmpcDoc5') %></span>
          </label>
          <label class="flex items-start gap-2 cursor-pointer">
            <input type="checkbox" class="lmpc-doc-check mt-0.5 rounded border-slate-300 text-govblue focus:ring-govblue">
            <span><%= t('lmpcDoc6') %></span>
          </label>
        </div>

        <div class="mt-4 pt-3 border-t border-slate-100 text-center">
          <a href="/inspections/new" class="text-xs text-govblue-light font-bold hover:underline flex items-center justify-center gap-1">
            <i class="fa-solid fa-shield-check"></i> <%= t('lmpcPreAuditLink') %>
          </a>
        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN: Statutory Roadmap & Instructions (col-span-7) -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- What is Rule 27? -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <h2 class="text-lg font-bold text-slate-900 mb-2"><%= t('lmpcMandateHeading') %></h2>
        <p class="text-xs text-slate-600 leading-relaxed mb-3">
          <%= t('lmpcMandateText') %>
        </p>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-3 rounded text-xs text-amber-900">
          <strong><%= t('lmpcMandateWarning') %></strong>
        </div>
      </div>

      <!-- Step-by-Step Visual Roadmap -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-6">
          <%= t('lmpcWorkflowHeading') %>
        </h3>

        <div class="space-y-6 relative before:absolute before:inset-0 before:left-3.5 before:w-0.5 before:bg-slate-200">
          
          <div class="relative flex items-start gap-4">
            <div class="w-7 h-7 rounded-full bg-govblue text-white flex items-center justify-center font-bold text-xs shrink-0 z-10">1</div>
            <div>
              <h4 class="font-bold text-xs text-slate-900"><%= t('lmpcWorkflowStep1Title') %></h4>
              <p class="text-xs text-slate-600 mt-0.5">
                <%= t('lmpcWorkflowStep1Desc') %>
              </p>
            </div>
          </div>

          <div class="relative flex items-start gap-4">
            <div class="w-7 h-7 rounded-full bg-govblue text-white flex items-center justify-center font-bold text-xs shrink-0 z-10">2</div>
            <div>
              <h4 class="font-bold text-xs text-slate-900"><%= t('lmpcWorkflowStep2Title') %></h4>
              <p class="text-xs text-slate-600 mt-0.5">
                <%= t('lmpcWorkflowStep2Desc') %>
              </p>
            </div>
          </div>

          <div class="relative flex items-start gap-4">
            <div class="w-7 h-7 rounded-full bg-govblue text-white flex items-center justify-center font-bold text-xs shrink-0 z-10">3</div>
            <div>
              <h4 class="font-bold text-xs text-slate-900"><%= t('lmpcWorkflowStep3Title') %></h4>
              <p class="text-xs text-slate-600 mt-0.5">
                <%= t('lmpcWorkflowStep3Desc') %>
              </p>
            </div>
          </div>

          <div class="relative flex items-start gap-4">
            <div class="w-7 h-7 rounded-full bg-govblue text-white flex items-center justify-center font-bold text-xs shrink-0 z-10">4</div>
            <div>
              <h4 class="font-bold text-xs text-slate-900"><%= t('lmpcWorkflowStep4Title') %></h4>
              <p class="text-xs text-slate-600 mt-0.5">
                <%= t('lmpcWorkflowStep4Desc') %>
              </p>
            </div>
          </div>

        </div>
      </div>

      <!-- Frequently Asked Questions -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4">
          <%= t('lmpcFaqHeading') %>
        </h3>

        <div class="space-y-4 text-xs">
          <div>
            <h4 class="font-bold text-slate-900"><%= t('lmpcFaq1Q') %></h4>
            <p class="text-slate-600 mt-1">
              <%= t('lmpcFaq1A') %>
            </p>
          </div>
          <div class="pt-3 border-t border-slate-100">
            <h4 class="font-bold text-slate-900"><%= t('lmpcFaq2Q') %></h4>
            <p class="text-slate-600 mt-1">
              <%= t('lmpcFaq2A') %>
            </p>
          </div>
          <div class="pt-3 border-t border-slate-100">
            <h4 class="font-bold text-slate-900"><%= t('lmpcFaq3Q') %></h4>
            <p class="text-slate-600 mt-1">
              <%= t('lmpcFaq3A') %>
            </p>
          </div>
        </div>
      </div>

    </div>

  </div>

</main>

<script src="/js/lmpc-calculator.js"></script>

<%- include('../partials/footer') %>
