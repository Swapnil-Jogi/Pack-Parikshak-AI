<footer class="bg-govblue-dark text-slate-300 text-xs mt-auto border-t border-slate-700">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Col 1: About & Emblem -->
      <div class="md:col-span-1">
        <div class="flex items-center space-x-2 mb-3">
          <div class="w-8 h-8 rounded bg-amber-500 flex items-center justify-center text-govblue-dark font-bold">
            <i class="fa-solid fa-scale-balanced"></i>
          </div>
          <span class="font-bold text-white text-sm"><%= t('portalName') %></span>
        </div>
        <p class="text-slate-400 text-xs leading-relaxed mb-3">
          <%= t('footerDesc') %>
        </p>
        <span class="inline-flex items-center px-2 py-1 rounded bg-slate-800 text-[11px] text-amber-400 border border-slate-700">
          <i class="fa-solid fa-shield-check me-1.5"></i> Section 36 Enforcement Ready
        </span>
      </div>

      <!-- Col 2: Statutory Rules -->
      <div>
        <h4 class="text-white font-semibold text-xs tracking-wider uppercase mb-3 border-b border-slate-700 pb-1">
          <%= t('statutoryFramework') %>
        </h4>
        <ul class="space-y-1.5 text-slate-400">
          <li><a href="/lmpc-guide" class="hover:text-amber-400 transition"><%= t('rule27Link') %></a></li>
          <li><a href="/inspections/new" class="hover:text-amber-400 transition"><%= t('rule6Link') %></a></li>
          <li><a href="/inspections/new" class="hover:text-amber-400 transition"><%= t('rule13Link') %></a></li>
          <li><a href="/inspections/new" class="hover:text-amber-400 transition"><%= t('sched2Link') %></a></li>
          <li><a href="/officer/dashboard" class="hover:text-amber-400 transition"><%= t('sec36Title') %></a></li>
        </ul>
      </div>

      <!-- Col 3: Portals & Utilities -->
      <div>
        <h4 class="text-white font-semibold text-xs tracking-wider uppercase mb-3 border-b border-slate-700 pb-1">
          <%= t('quickLinks') %>
        </h4>
        <ul class="space-y-1.5 text-slate-400">
          <li><a href="/dashboard" class="hover:text-amber-400 transition"><%= t('scanHistory') %></a></li>
          <li><a href="/officer/dashboard" class="hover:text-amber-400 transition"><%= t('officerPortal') %></a></li>
          <li><a href="/inspections/new" class="hover:text-amber-400 transition"><%= t('scan') %></a></li>
          <li><a href="/reports/export/csv" class="hover:text-amber-400 transition"><%= t('btnExportCsv') %></a></li>
          <li><a href="/lmpc-guide" class="hover:text-amber-400 transition"><%= t('lmpcGuide') %></a></li>
        </ul>
      </div>

      <!-- Col 4: Consumer Redressal & Contact -->
      <div>
        <h4 class="text-white font-semibold text-xs tracking-wider uppercase mb-3 border-b border-slate-700 pb-1">
          <%= t('deptConsumerAffairs') %>
        </h4>
        <div class="space-y-2 text-slate-400">
          <p class="flex items-center text-amber-400 font-semibold">
            <i class="fa-solid fa-phone-volume me-2"></i> <%= t('nationalConsumerHelpline') %>
          </p>
          <p class="flex items-center">
            <i class="fa-solid fa-envelope me-2 text-slate-500"></i> lm-enforcement@gov.in
          </p>
          <p class="text-[11px] text-slate-500">
            Directorate of Legal Metrology, Krishi Bhawan, New Delhi - 110001
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="border-t border-slate-800 mt-8 pt-4 flex flex-col sm:flex-row items-center justify-between text-slate-500 text-[11px]">
      <p>© <%= new Date().getFullYear() %> <%= t('portalName') %>. <%= t('allRightsReserved') %></p>
      <div class="flex items-center space-x-4 mt-2 sm:mt-0">
        <a href="/lmpc-guide" class="hover:text-slate-400">Statutory Notice</a>
        <span>•</span>
        <a href="/architecture" class="hover:text-slate-400">Render Deployment</a>
        <span>•</span>
        <span class="text-emerald-400 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> OCR Microservice Active
        </span>
      </div>
    </div>
  </div>
</footer>

<!-- Bootstrap 5 Bundle JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

