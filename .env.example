# ==============================================================================
# Pack-Parikshak AI (पैक-परीक्षक एआई) - Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Application Environment ('development' or 'production')
NODE_ENV=production

# Server Port (Default: 8080)
PORT=8080

# MongoDB Connection URI (Local standalone, Docker container, or MongoDB Atlas cloud cluster)
# Local: mongodb://127.0.0.1:27017/pack_parikshak
# Docker Compose: mongodb://mongodb:27017/pack_parikshak
# Production Atlas: mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/pack_parikshak?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pack_parikshak

# Security Secrets (Generate random 32+ character strings for production)
SESSION_SECRET=replace_with_strong_random_session_secret_min_32_characters
JWT_SECRET=replace_with_strong_random_jwt_secret_min_32_characters

# Python PaddleOCR Microservice Configuration
PYTHON_OCR_URL=http://127.0.0.1:5000/api/ocr
PYTHON_OCR_PORT=5000
PYTHON_OCR_HOST=127.0.0.1

# Cloudinary Cloud Storage (Recommended for production to avoid ephemeral container storage)
# If blank, images are safely stored locally in /public/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Official Email Notification Service (Nodemailer for Warning Notices & SCNs)
# If left blank in development, an automatic Ethereal test inbox is created
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=enforcement.lm@example.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM="Legal Metrology Enforcement Wing <enforcement.lm@gov.in>"
