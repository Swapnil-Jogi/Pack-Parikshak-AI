<%- include('../partials/header', { title: (typeof isOfficer !== 'undefined' && isOfficer ? 'Officer Scans Dashboard' : t('consumerDashboardTitle')) + ' | ' + t('portalName') }) %>
<%- include('../partials/navbar') %>

<main class="flex-grow py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
  
  <!-- Header & Stats Summary -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
    <div>
      <div class="flex flex-wrap items-center gap-2 mb-1">
        <% if (typeof isOfficer !== 'undefined' && isOfficer) { %>
          <span class="px-2 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-300 text-[11px] font-bold flex items-center gap-1">
            <i class="fa-solid fa-shield-halved text-amber-600"></i> Officer Uploaded Inspections Portal
          </span>
          <a href="/officer/dashboard" class="text-[11px] text-govblue font-bold hover:underline flex items-center gap-1 ms-2">
            <i class="fa-solid fa-arrow-left"></i> Enforcement Command Hub
          </a>
        <% } else { %>
          <span class="px-2 py-0.5 rounded bg-blue-100 text-govblue text-[11px] font-bold"><%= t('userPortalBadge') %></span>
        <% } %>
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
        <%= typeof isOfficer !== 'undefined' && isOfficer ? 'Uploaded Package Inspections' : t('auditHistoryHeading') %>
      </h1>
      <p class="text-xs text-slate-500 mt-0.5">
        <%= typeof isOfficer !== 'undefined' && isOfficer ? 'Real-time record of all packaged commodities inspected with statutory rule evaluations and raw OCR analysis' : t('auditHistorySub') %>
      </p>
    </div>

    <div class="flex items-center gap-2">
      <% if (typeof isOfficer !== 'undefined' && isOfficer) { %>
        <div class="btn-group btn-group-sm shadow-xs" role="group">
          <a href="/dashboard?filter=my" class="btn btn-sm text-xs font-semibold py-1.5 px-3 <%= (typeof currentFilter === 'undefined' || currentFilter === 'my') ? 'btn-govblue text-white' : 'btn-outline-secondary' %>">
            My Uploads
          </a>
          <a href="/dashboard?filter=all" class="btn btn-sm text-xs font-semibold py-1.5 px-3 <%= (typeof currentFilter !== 'undefined' && currentFilter === 'all') ? 'btn-govblue text-white' : 'btn-outline-secondary' %>">
            All Repository
          </a>
        </div>
      <% } %>
      <a href="/reports/export/csv" class="btn btn-outline-secondary btn-sm text-xs font-semibold py-2 px-3 shadow-sm">
        <i class="fa-solid fa-file-csv me-1 text-emerald-600"></i> <%= t('exportCsvBtn') %>
      </a>
      <a href="/inspections/new" class="btn bg-govblue hover:bg-govblue-dark text-white btn-sm text-xs font-bold py-2 px-4 shadow-sm flex items-center gap-1.5">
        <i class="fa-solid fa-plus"></i> <%= t('newPackageScanBtn') %>
      </a>
    </div>
  </div>

  <% if (typeof showingAllFallback !== 'undefined' && showingAllFallback) { %>
    <div class="bg-blue-50 border-l-4 border-govblue p-3.5 rounded-lg mb-6 flex items-center justify-between text-xs text-slate-700">
      <div class="flex items-center gap-2">
        <i class="fa-solid fa-circle-info text-govblue text-sm"></i>
        <span>No custom uploads yet under your officer account. Showing recent verified commodity scans from the statutory database.</span>
      </div>
      <a href="/inspections/new" class="btn btn-xs bg-govblue text-white font-bold py-1 px-2.5 rounded">
        Upload Your First Scan
      </a>
    </div>
  <% } %>

  <!-- Metric KPI Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
      <div class="text-[11px] font-bold text-slate-500 uppercase"><%= t('totalScansCard') %></div>
      <div class="text-2xl font-extrabold text-slate-900 mt-1"><%= stats.totalScans %></div>
    </div>
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
      <div class="text-[11px] font-bold text-slate-500 uppercase"><%= t('compliantCard') %></div>
      <div class="text-2xl font-extrabold text-emerald-600 mt-1"><%= stats.compliantCount %></div>
    </div>
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
      <div class="text-[11px] font-bold text-slate-500 uppercase"><%= t('flaggedViolationsCard') %></div>
      <div class="text-2xl font-extrabold text-red-600 mt-1"><%= stats.violationCount %></div>
    </div>
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
      <div class="text-[11px] font-bold text-slate-500 uppercase"><%= t('averageScoreCard') %></div>
      <div class="text-2xl font-extrabold text-amber-500 mt-1"><%= stats.avgScore %>%</div>
    </div>
  </div>

  <!-- Inspection History Table -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="p-4 border-b border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">
        <%= t('auditRecordsHeading') %>
      </h3>
      <div class="text-xs text-slate-500">
        <%= t('showingRecentPrefix') %> <%= inspections.length %> <%= t('showingRecentSuffix') %>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="table table-hover align-middle mb-0 text-xs">
        <thead class="bg-slate-50 text-slate-600 uppercase text-[10px] font-bold border-b border-slate-200">
          <tr>
            <th class="ps-4 py-3"><%= t('colInspectionId') %></th>
            <th class="py-3">Uploaded Image & Commodity</th>
            <th class="py-3"><%= t('colCategory') %></th>
            <th class="py-3"><%= t('colNetQuantity') %></th>
            <th class="py-3"><%= t('colStatus') %></th>
            <th class="py-3 text-center"><%= t('colScore') %></th>
            <th class="py-3"><%= t('colDate') %></th>
            <th class="pe-4 py-3 text-end"><%= t('colActions') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (inspections.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center py-8 text-slate-500">
                <i class="fa-solid fa-box-open text-2xl text-slate-400 mb-2"></i>
                <p><%= t('noInspectionsYet') %></p>
                <a href="/inspections/new" class="btn btn-primary btn-sm text-xs mt-2"><%= t('startFirstInspectionBtn') %></a>
              </td>
            </tr>
          <% } else { %>
            <% inspections.forEach(item => { %>
              <tr>
                <td class="ps-4 font-mono font-bold text-slate-700">
                  <a href="/inspections/<%= item._id %>/sandbox" class="hover:text-govblue hover:underline">
                    <%= item.inspectionNumber %>
                  </a>
                </td>
                <td>
                  <div class="flex items-center gap-3">
                    <a href="/inspections/<%= item._id %>/sandbox" class="relative group block flex-shrink-0" title="Click to open verification sandbox">
                      <img src="<%= item.imageUrl %>" alt="<%= item.productName %>" class="w-12 h-12 object-cover rounded-lg border border-slate-200 shadow-xs group-hover:scale-105 transition bg-slate-100" onerror="this.src='/images/placeholder-package.svg'; this.onerror=null;">
                    </a>
                    <div>
                      <a href="/inspections/<%= item._id %>/sandbox" class="font-bold text-slate-900 hover:text-govblue hover:underline block leading-tight">
                        <%= item.productName %>
                      </a>
                      <div class="text-[10px] text-slate-500 mt-0.5"><%= item.brand %></div>
                    </div>
                  </div>
                </td>
                <td class="text-slate-600"><%= item.category %></td>
                <td class="font-semibold text-slate-800"><%= item.extractedData.netQuantity || '-' %></td>
                <td>
                  <% if (item.complianceStatus === 'COMPLIANT') { %>
                    <span class="badge bg-emerald-100 text-emerald-800 border border-emerald-300"><%= t('statusCompliant') %></span>
                  <% } else if (item.complianceStatus === 'WARNING') { %>
                    <span class="badge bg-amber-100 text-amber-800 border border-amber-300"><%= t('statusWarning') %></span>
                  <% } else { %>
                    <span class="badge bg-red-100 text-red-800 border border-red-300"><%= t('statusNonCompliant') %></span>
                  <% } %>
                </td>
                <td class="text-center font-bold">
                  <span class="<%= item.complianceScore >= 80 ? 'text-emerald-600' : item.complianceScore >= 50 ? 'text-amber-600' : 'text-red-600' %>">
                    <%= item.complianceScore %>%
                  </span>
                </td>
                <td class="text-slate-500"><%= new Date(item.createdAt).toLocaleDateString('en-IN') %></td>
                <td class="pe-4 text-end space-x-1">
                  <a href="/inspections/<%= item._id %>/sandbox" class="btn btn-outline-primary btn-sm text-[11px] py-1 px-2.5" title="<%= t('btnSandbox') %>">
                    <i class="fa-solid fa-eye me-1"></i> <%= t('btnSandbox') %>
                  </a>
                  <a href="/reports/<%= item._id %>/pdf" class="btn btn-outline-danger btn-sm text-[11px] py-1 px-2.5" title="<%= t('btnDownloadPdf') %>">
                    <i class="fa-solid fa-file-pdf"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</main>

<%- include('../partials/footer') %>
