<% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-3">
    <% (Array.isArray(success_msg) ? success_msg : [success_msg]).forEach(function(msg) { %>
      <div class="alert alert-success alert-dismissible fade show flex items-center justify-between p-3.5 rounded-xl border border-emerald-300 bg-emerald-50 text-emerald-900 shadow-sm text-xs mb-2" role="alert">
        <div class="flex items-center gap-2.5">
          <i class="fa-solid fa-circle-check text-emerald-600 text-sm flex-shrink-0"></i>
          <span class="font-medium"><%= msg %></span>
        </div>
        <button type="button" class="btn-close text-xs p-2 text-emerald-700 hover:text-emerald-900" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% }); %>
  </div>
<% } %>

