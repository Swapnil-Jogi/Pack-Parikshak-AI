<%- include('../partials/header', { title: 'Upload Package for Verification | Pack-Parikshak AI' }) %>
<%- include('../partials/navbar') %>

<main class="flex-grow py-10 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
  
  <div class="mb-8 text-center sm:text-left">
    <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-blue-50 text-govblue text-xs font-bold border border-blue-200 mb-2">
      <i class="fa-solid fa-camera"></i> AI Packaging Inspection Portal
    </div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight"><%= t('uploadTitle') %></h1>
    <p class="text-xs text-slate-600 mt-1">
      <%= t('uploadSubtitle') %>
    </p>
  </div>

  <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <div class="bg-red-50 border-l-4 border-red-500 p-3 rounded text-xs text-red-700 mb-6">
      <i class="fa-solid fa-circle-exclamation me-1"></i> <%= errorMessage %>
    </div>
  <% } %>

  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 sm:p-8">
    <form action="/inspections/upload" method="POST" enctype="multipart/form-data" class="space-y-6">
      
      <!-- Upload Dropzone -->
      <div>
        <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider mb-2">
          <%= t('uploadCardTitle') %>
        </label>
        <div class="border-2 border-dashed border-slate-300 hover:border-govblue rounded-xl p-8 text-center bg-slate-50/50 hover:bg-slate-50 transition cursor-pointer" onclick="document.getElementById('fileInput').click()">
          <input type="file" id="fileInput" name="image" accept="image/*" class="hidden" onchange="previewSelectedFile(this)">
          <div class="w-12 h-12 bg-blue-100 text-govblue rounded-full flex items-center justify-center mx-auto mb-3 text-xl">
            <i class="fa-solid fa-cloud-arrow-up"></i>
          </div>
          <p class="text-xs font-bold text-slate-800" id="filePromptText">
            <%= t('uploadDragDrop') %>
          </p>
          <p class="text-[11px] text-slate-500 mt-1"><%= t('uploadFormats') %></p>
          <div id="imagePreviewContainer" class="mt-4 hidden">
            <img id="imagePreview" src="#" alt="Preview" class="max-h-48 mx-auto rounded border border-slate-300 shadow-sm">
          </div>
        </div>
      </div>

      <!-- Optional Metadata -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1"><%= t('fieldCommodity') %></label>
          <input type="text" name="productName" placeholder="e.g. Basmati Rice 5kg" class="form-control text-xs py-2 rounded-lg">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Product Category</label>
          <select name="category" class="form-select text-xs py-2 rounded-lg">
            <option value="Food & Groceries">Food & Groceries</option>
            <option value="Beverages">Beverages</option>
            <option value="Cosmetics & Personal Care">Cosmetics & Personal Care</option>
            <option value="Electronics & Appliances">Electronics & Appliances</option>
            <option value="Pharmaceuticals">Pharmaceuticals</option>
            <option value="General Merchandise">General Merchandise</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1"><%= t('jurisdictionLabel') %></label>
          <select name="state" class="form-select text-xs py-2 rounded-lg">
            <option value="Delhi">Delhi</option>
            <option value="Maharashtra">Maharashtra</option>
            <option value="Karnataka">Karnataka</option>
            <option value="Gujarat">Gujarat</option>
            <option value="Tamil Nadu">Tamil Nadu</option>
            <option value="Uttar Pradesh">Uttar Pradesh</option>
            <option value="West Bengal">West Bengal</option>
            <option value="Punjab">Punjab</option>
          </select>
        </div>
      </div>

      <!-- Instant Sample Buttons alternative -->
      <div class="pt-4 border-t border-slate-200">
        <label class="block text-xs font-bold text-slate-800 mb-2"><%= t('orTrySamples') %></label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <button type="submit" name="sampleType" value="wheat_flour" class="btn btn-outline-success text-xs font-semibold py-2.5 text-start flex items-center justify-between">
            <span><i class="fa-solid fa-check-circle me-1.5"></i> Scenario A: <%= t('wheatFlourTitle') %></span>
            <span class="badge bg-emerald-600"><%= t('statusCompliant') %></span>
          </button>
          <button type="submit" name="sampleType" value="snack_pack" class="btn btn-outline-danger text-xs font-semibold py-2.5 text-start flex items-center justify-between">
            <span><i class="fa-solid fa-triangle-exclamation me-1.5"></i> Scenario B: <%= t('snackPackTitle') %></span>
            <span class="badge bg-red-600"><%= t('statusNonCompliant') %></span>
          </button>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="pt-4">
        <button type="submit" id="submitBtn" class="w-full btn bg-govblue hover:bg-govblue-dark text-white font-bold text-xs py-3 rounded-lg shadow-md transition flex items-center justify-center gap-2">
          <i class="fa-solid fa-magnifying-glass"></i> <%= t('uploadBtn') %>
        </button>
      </div>

    </form>
  </div>
</main>

<script>
  function previewSelectedFile(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('imagePreview').src = e.target.result;
        document.getElementById('imagePreviewContainer').classList.remove('hidden');
        document.getElementById('filePromptText').innerText = input.files[0].name;
      }
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>

<%- include('../partials/footer') %>

